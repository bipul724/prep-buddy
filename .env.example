# Copy to .env and adjust:  cp .env.example .env
# Everything runs locally. No API keys and no paid services are needed.

# Postgres + pgvector from docker-compose.yml.
# Port 5433 (not 5432) because PostgreSQL 18 is already running on 5432 on this Mac.
DATABASE_URL="postgresql://prep:prep@localhost:5433/prepbuddy?schema=public"

# Ollama runs natively on macOS (not in Docker), so it can use the Apple GPU.
OLLAMA_BASE_URL="http://localhost:11434"

# Chat model. 8 GB M2: gemma3:4b (3.3 GB) is the default.
# Fallbacks: gemma3:1b (815 MB, fastest) | gemma4:e2b (4.6 GB, close other apps first)
CHAT_MODEL="gemma3:4b"

# Embedding model (EmbeddingGemma, 768 dims, 2K-token context). Must match vector(768) in schema.prisma.
EMBED_MODEL="embeddinggemma"
EMBED_DIMENSIONS="768"

# Feature flags
REPHRASE_QUESTIONS="true"   # interviewer agent rewrites bank questions conversationally (adds ~1 model call)
MAX_ANSWER_CHARS="4000"     # longer answers are rejected with 400 VALIDATION_ERROR
