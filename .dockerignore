# Prep Buddy .dockerignore
# Only used if you later add a Dockerfile to containerize the Next.js app.
# The current docker-compose.yml runs only the database from a prebuilt image,
# so this file has no effect today.

# dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo

# generated Prisma client (regenerated by `prisma generate` in the image)
src/generated

# secrets: pass env vars at runtime instead
.env*
!.env.example
*.pem

# version control and local tooling
.git
.gitignore
.dockerignore
.vscode
.idea
.DS_Store
.mastra
*.db
*.db-journal

# docs, media and logs are not needed to run the app
docs
*.md
!README.md
*.mp4
*.mov
exports
scratch
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# compose file and Docker files themselves
docker-compose.yml
Dockerfile*
