# Prep Buddy .gitignore
# Based on the create-next-app@16.3.8 template, plus project-specific rules.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real values, but keep the example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- prep-buddy ----
# Prisma client is generated by `prisma generate` (postinstall), never committed
/src/generated/

# Mastra local artifacts (only created if you run `mastra dev` / Studio)
/.mastra/
*.db
*.db-journal

# Local exports, recordings and scratch files
/exports/
*.mp4
*.mov
/scratch/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
